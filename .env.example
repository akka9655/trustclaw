# ──────────────────────────────────────────────────────────────────────────────
# TrustClaw — Environment Variables
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────────────────────────

# --- App ---
# Public URL of the deployed app. On Vercel this is auto-detected — leave blank.
# For local dev also leave blank (derived from PORT automatically).
NEXT_PUBLIC_APP_URL=

# --- Database (required) ---
# Postgres with the pgvector extension enabled.
# Free options: Neon (neon.tech) · Supabase · Railway
DATABASE_URL=

# --- Auth (required) ---
# Random 32+ char secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Google AI / Gemini (required) ---
# FREE API key — get one at https://aistudio.google.com/apikey
# Powers the main agent (Gemini 2.5 Flash) and all compaction. No billing needed.
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Composio (optional) ---
# Only needed to enable external tool integrations (Gmail, GitHub, Slack, etc.)
# Free tier available at https://dashboard.composio.dev/login?flow=developer
# Leave blank to disable Composio tools.
COMPOSIO_API_KEY=

# --- Cron auth (required) ---
# Random 32+ char secret to authenticate /api/cron/* endpoints.
# On Vercel, auto-injected when crons are declared in vercel.json.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# --- Telegram bot (optional) ---
# Create a bot via @BotFather on Telegram. Leave blank to disable Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- Redis (optional) ---
# Enables resumable streams & agent rate limits. Basic streaming works without it.
# Free options: Upstash (upstash.com) — generous free tier
REDIS_URL=

# --- Agent rate limits (optional) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_DAY=500
RATE_LIMIT_CRON_PER_DAY=100
RATE_LIMIT_TELEGRAM_PER_MINUTE=20
RATE_LIMIT_FAIL_MODE=
